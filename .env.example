# AWS SNS to Slack Forwarder Configuration

# ==============================================================================
# Slack Configuration (Required)
# ==============================================================================

# Slack Bot Token (required)
# Can be a direct value or SSM parameter ARN
SLACK_TOKEN=xoxb-your-slack-bot-token
# Or use SSM:
# SLACK_TOKEN=arn:aws:ssm:us-east-1:123456789012:parameter/slack/bot-token

# Default Slack channel ID for fallback (required if FALLBACK_ENABLED=true)
SLACK_DEFAULT_CHANNEL=C01234567890

# ==============================================================================
# Routing Configuration
# ==============================================================================

# Option 1: Inline JSON routing rules (use for dev/test)
SNS_ROUTES='[
  {
    "name": "production-alerts",
    "sns_topic_arn": "arn:aws:sns:us-east-1:123456789012:prod-alerts",
    "slack_channel_id": "C01234567890",
    "enabled": true
  },
  {
    "name": "staging-pattern",
    "sns_topic_arn_pattern": ".*:staging-.*",
    "slack_channel_id": "C09876543210",
    "enabled": true
  },
  {
    "name": "error-alerts",
    "sns_topic_arn_pattern": ".*-errors$",
    "message_subject_pattern": "ERROR|CRITICAL",
    "slack_channel_id": "C05555555555",
    "enabled": true
  }
]'

# Option 2: SSM Parameter ARN containing routing rules (TAKES PRECEDENCE)
# If specified, SNS_ROUTES is ignored
# SNS_ROUTES_PARAM_ARN=arn:aws:ssm:us-east-1:123456789012:parameter/sns-forwarder/routes

# ==============================================================================
# Behavior Configuration
# ==============================================================================

# Send messages to default channel if no route matches (default: true)
FALLBACK_ENABLED=true

# Enable debug logging (default: false)
DEBUG_ENABLED=false

# Validate SNS message signatures (default: false)
# Note: Not typically needed in Lambda as AWS validates before invocation
VALIDATE_SNS_SIGNATURES=false

# Send notification to default channel when new SNS subscription is confirmed (default: false)
NOTIFY_ON_SUBSCRIPTION=false
