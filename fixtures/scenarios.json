[
  {
    "name": "simple_sns_notification",
    "description": "Test simple SNS notification forwarded to default Slack channel",
    "sns_payload": {
      "Records": [
        {
          "EventSource": "aws:sns",
          "EventVersion": "1.0",
          "Sns": {
            "Type": "Notification",
            "MessageId": "test-msg-123",
            "TopicArn": "arn:aws:sns:us-east-1:123456789012:test-alerts",
            "Subject": "Test Alert",
            "Message": "This is a test alert message",
            "Timestamp": "2025-01-15T10:30:00.000Z"
          }
        }
      ]
    },
    "expected_calls": [
      {
        "service": "slack",
        "method": "POST",
        "path": "/chat.postMessage"
      }
    ],
    "mock_responses": [
      {
        "service": "slack",
        "method": "POST",
        "path": "/auth.test",
        "status_code": 200,
        "body": "{\"ok\":true,\"user\":\"test_user\",\"team\":\"Test Team\"}"
      },
      {
        "service": "slack",
        "method": "POST",
        "path": "/chat.postMessage",
        "status_code": 200,
        "body": "{\"ok\":true,\"channel\":\"C01234DEFAULT\",\"ts\":\"1234567890.123456\"}"
      }
    ]
  },
